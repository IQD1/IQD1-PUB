<mxfile host="app.diagrams.net">
  <diagram id="flow2" name="复杂测试页">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="check" value="条件成立?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lane" value="处理模块" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="460" height="180" as="geometry" />
        </mxCell>
        <mxCell id="stepA" value="步骤A：解析输入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane">
          <mxGeometry x="20" y="50" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="stepB" value="步骤B：写库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane">
          <mxGeometry x="240" y="50" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ok" value="处理完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="180" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="跳过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="380" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="start" target="check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=segmentEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;" edge="1" parent="1" source="check" target="lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;" edge="1" parent="1" source="check" target="ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="check" target="fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="lane" target="ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="第二轮：AI 原地更新同一个文件，测试写入稳定性" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;fillColor=#FFF9B2;strokeColor=none;shadow=1;size=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="500" width="240" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>